<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% set pageDescription = description or site.description %}
  {% set pageUrl = canonical_url or (site.url + page.url) %}
  {# Cards read better without the " – Notebucket" suffix the <title> carries. #}
  {% set cardTitle = site.wordmark if page.url == "/" else (title or site.wordmark) %}
  <title>{% if title %}{{ title }} – {{ site.wordmark }}{% else %}{{ site.wordmark }}{% endif %}</title>
  <meta name="description" content="{{ pageDescription }}">
  {% if canonical_url %}<link rel="canonical" href="{{ canonical_url }}">{% endif %}

  {# Preview cards. No og:image yet, so these stay text-only. #}
  <meta property="og:type" content="{{ og_type or 'website' }}">
  <meta property="og:title" content="{{ cardTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:site_name" content="{{ site.wordmark }}">
  {% if og_type == 'article' and date %}<meta property="article:published_time" content="{{ date | isoDate }}">{% endif %}
  <meta name="twitter:card" content="summary">
  <link rel="icon" href="/img/favicon-32.png" type="image/png">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/notebucket/rss.xml">
  <script>
    window.MathJax = {
      tex: { inlineMath: [['\\(', '\\)']], displayMath: [['\\[', '\\]']] }
    };
  </script>
  <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js" async></script>
</head>
<body>
  <header class="site-header">
    <div class="site-header-inner">
      <a class="site-title" href="/"><img src="/img/bucket-sparkle-128.png" alt="" width="40" height="40">{{ site.wordmark }}</a>
      <nav class="site-nav">
        <a href="/about/">About</a>
      </nav>
    </div>
  </header>

  <main class="site-main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>{{ site.title }}</p>
  </footer>
</body>
</html>
