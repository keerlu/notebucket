{# Shared post listing. Set `posts` before including. #}
<div class="post-list">
  {% for post in posts %}
    <article class="post-card">
      <time class="post-card-date" datetime="{{ post.data.date | isoDate }}">{{ post.data.date | compactDate | safe }}</time>
      <h2 class="post-card-title">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </h2>
    </article>
  {% endfor %}
</div>
